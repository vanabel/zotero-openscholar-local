# 复制为 apps/api/.env.hpc，供 submit_vectors*.slurm 在计算节点 source。
# 文档：docs/HPC.md
# Mac 同步：scripts/hpc/sync_to_hpc.sh（见 sync_to_hpc.env.example）
# 集群无 Ollama；嵌入走 OpenAI 兼容 API（见下）

# 超算绝对路径（与 sync_to_hpc.sh models 输出提示一致）
DATA_DIR=/public/home/<账号>/zotero-openscholar-local/apps/api/data

# 超算解析 PDF（sync_to_hpc.sh pdfs）；库内 pdf_path 仍为 Mac 路径时可自动映射
ZOTERO_STORAGE_PATH=/public/home/<账号>/zotero-openscholar-local/apps/api/data/zotero-storage

# MinerU CLI（超算 GPU 解析，见 docs/HPC_PARSE.md）
MINERU_MODE=cli
MINERU_CLI=/public/home/<账号>/zotero-openscholar-local/apps/api/.venv/bin/mineru
MINERU_MODEL_SOURCE=local
MINERU_TOOLS_CONFIG_JSON=/public/home/<账号>/zotero-openscholar-local/apps/api/config/mineru.hpc.json
# SWU 本地 MinerU：VLM 后端使用本地权重；避开 pipeline 的 onnxruntime 依赖
MINERU_CLI_EXTRA_ARGS="--backend vlm-auto-engine --source local"
# SWU 计算节点无外网 DNS；本地 MinerU 解析不做低分云端重试
PARSE_QUALITY_RETRY_ENABLED=0
# pipeline / 独立 mineru-api 模式才需要：
# MINERU_API_URL=http://127.0.0.1:8001
# MINERU_MODE=cloud
# MINERU_API_TOKEN=

# 可选：整段路径前缀替换（一般只需 ZOTERO_STORAGE_PATH）
# HPC_PDF_PATH_PREFIX_OLD=/Users/<你>/Zotero/storage
# HPC_PDF_PATH_PREFIX_NEW=/public/home/<账号>/zotero-openscholar-local/apps/api/data/zotero-storage

# 普通嵌入（embedding_json）— 走 OpenAI 兼容 HTTP API
EMBED_PROVIDER=openai
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
# 本地 Mac 对话仍可用 Ollama；超算作业不调用 CHAT

# OpenScholar Retriever（scholar_embedding_json）— GPU
OPENSCHOLAR_RETRIEVER_ENABLED=1
OPENSCHOLAR_RERANKER_ENABLED=0
OPENSCHOLAR_DEVICE=cuda
OPENSCHOLAR_ENCODE_BATCH_SIZE=32

# 方式 A：Mac 已 rsync 本地权重（推荐，出网不稳定时）
OPENSCHOLAR_RETRIEVER_MODEL=/public/home/<账号>/models/openscholar-retriever
# OPENSCHOLAR_RERANKER_MODEL=/public/home/<账号>/models/openscholar-reranker

# 方式 B：计算节点从 Hugging Face 下载（需出网；缓存目录见 HF_HOME）
# OPENSCHOLAR_RETRIEVER_MODEL=OpenSciLM/OpenScholar_Retriever
# HF_HOME=/public/home/<账号>/.cache/huggingface
# HF_TOKEN=hf_xxx
# HF_ENDPOINT=https://hf-mirror.com

LANCEDB_ENABLED=1
