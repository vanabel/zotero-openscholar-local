# 复制为 apps/api/.env.hpc，供 submit_vectors*.slurm 在计算节点 source。
# 文档：docs/HPC.md（SWU 示例：DATA_DIR=/public/home/<账号>/zotero-openscholar-local/apps/api/data）
# 集群无 Ollama、允许出网：EMBED_PROVIDER=openai + OPENAI_*（见下）

DATA_DIR=/path/to/synced/data

# 普通嵌入（embedding_json）— 走 OpenAI 兼容 HTTP API
EMBED_PROVIDER=openai
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
# 本地 Mac 对话仍可用 Ollama；超算作业不调用 CHAT

# OpenScholar Retriever（scholar_embedding_json）— GPU + Hugging Face
OPENSCHOLAR_RETRIEVER_ENABLED=1
OPENSCHOLAR_RERANKER_ENABLED=0
OPENSCHOLAR_DEVICE=cuda
OPENSCHOLAR_ENCODE_BATCH_SIZE=32
# OPENSCHOLAR_RETRIEVER_MODEL=OpenSciLM/OpenScholar_Retriever
# HF_TOKEN=hf_xxx
# HF_ENDPOINT=https://hf-mirror.com
LANCEDB_ENABLED=1
