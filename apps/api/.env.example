# 复制为 apps/api/.env 后按需修改。未写出的变量在代码中有默认值（见 app/config.py）。

# ── 路径（本机 Zotero 不在默认位置时取消注释）────────────────────────
# 默认 ~/Zotero/storage；相对路径会在启动时按 cwd 解析，建议用绝对路径
# ZOTERO_STORAGE_PATH=~/Zotero/storage
# 题录/作者/标签/集合只读同步；默认 ~/Zotero/zotero.sqlite，空字符串可关闭
# ZOTERO_SQLITE_PATH=~/Zotero/zotero.sqlite
# 应用数据目录（SQLite、解析缓存等）；默认 ./data（相对 API 启动 cwd）
# DATA_DIR=./data
# 启动时 SQLite VACUUM（大量 DELETE 后回收空洞；需 API 独占库文件）
# DB_VACUUM_ON_STARTUP=0
# freelist 页占比 ≥ 该值时自动 VACUUM（默认 0.25）；设为 0 则仅 DB_VACUUM_ON_STARTUP=1 时执行
# DB_VACUUM_FREELIST_RATIO=0.25

# ── 对话 / 嵌入 Provider（可混用）────────────────────────────────────
# CHAT_PROVIDER / EMBED_PROVIDER：auto | ollama | openai
#   auto = 配置了 OPENAI_API_KEY+BASE 时用 openai，否则 ollama（与旧版「填 Key 即全开」兼容）
#   显式 ollama / openai 可让「对话本地 + 嵌入在线」或反过来
CHAT_PROVIDER=auto
EMBED_PROVIDER=auto

OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Ollama 地址；默认 http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# 主对话若用 OpenScholar-8B：Ollama 加载 GGUF 后的名字（见 README）
# OLLAMA_CHAT_MODEL=openscholar:8b

# OpenAI 兼容 API（OpenAI / DeepSeek / 其它网关；CHAT 或 EMBED 为 openai/auto 时需要）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── 推荐组合（复制对应块到 .env；切换嵌入后请对文献库「重建索引」）────
#
# | 场景              | CHAT_PROVIDER | EMBED_PROVIDER | 还需 |
# |-------------------|---------------|------------------|------|
# | 全本地（默认）    | auto 或 ollama | auto 或 ollama   | Ollama 模型 |
# | 全在线 API        | auto 或 openai | auto 或 openai   | OPENAI_* |
# | 本地对话+在线嵌入 | ollama        | openai           | OPENAI_* + 重建索引 |
# | 在线对话+本地嵌入 | openai        | ollama           | OPENAI_*；检索仍可用 OpenScholar |
# | 本地对话+OS 检索  | ollama        | ollama           | OPENSCHOLAR_*=1（嵌入索引用 Ollama；稠密召回用 scholar 向量） |
#
# 说明：
# - embedding_json（Ollama/OpenAI）与 scholar_embedding_json（OpenScholar）是两套向量；勿混用不同 EMBED 模型而不重建索引。
# - OpenScholar Retriever/Reranker 仅本机 PyTorch，与 CHAT/EMBED provider 独立，见下节。

# ── 检索（影响召回量、延迟与上下文长度）──────────────────────────────
RETRIEVE_TOP_K_FTS=40
RETRIEVE_TOP_K_FINAL=8
# OpenScholar 稠密召回 + 精排（PyTorch，低配机可设为 0 关闭）
OPENSCHOLAR_RETRIEVER_ENABLED=1
OPENSCHOLAR_RERANKER_ENABLED=1
OPENSCHOLAR_DEVICE=auto
# 跨篇均衡：单篇最多 chunk / 最多文献篇数（0 = 不限制该项）；默认 3 / 8
# RETRIEVE_MAX_CHUNKS_PER_PAPER=3
# RETRIEVE_MAX_PAPERS=8
# 模型 ID 或本地绝对路径；默认 OpenSciLM/OpenScholar_Retriever|Reranker
# OPENSCHOLAR_RETRIEVER_MODEL=OpenSciLM/OpenScholar_Retriever
# OPENSCHOLAR_RERANKER_MODEL=OpenSciLM/OpenScholar_Reranker
# 精排候选池大小；默认 80
# OPENSCHOLAR_RERANK_POOL=80
# OPENSCHOLAR_RETRIEVER_MAX_LENGTH=512
# OPENSCHOLAR_ENCODE_BATCH_SIZE=8
# OPENSCHOLAR_RERANK_BATCH_SIZE=8
# OPENSCHOLAR_RERANK_MAX_CHARS=1800
# HF_TOKEN=hf_xxx
# HF_ENDPOINT=https://hf-mirror.com

# ── PDF 解析（cli 本机 / cloud 在线 API）─────────────────────────────
MINERU_MODE=cli
# cloud 模式必填 Token：https://mineru.net/apiManage/docs
# MINERU_API_TOKEN=
# 默认可执行名 mineru；PATH 找不到时请写绝对路径
# MINERU_CLI=mineru
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_CLOUD_MODEL_VERSION=vlm
# MINERU_CLOUD_POLL_INTERVAL_SEC=5
# MINERU_CLOUD_MAX_PAGES_PER_CHUNK=200
# MINERU_CLI_STYLE=v3
# 常驻 mineru-api（pnpm dev 默认 8001，勿与 API 8000 冲突）
# MINERU_API_URL=http://127.0.0.1:8001
# MINERU_MODEL_SOURCE=local
# MINERU_TOOLS_CONFIG_JSON=/absolute/path/to/mineru.json
# MINERU_TASK_POLL_INTERVAL_SEC=8

# ── 可选能力 ─────────────────────────────────────────────────────────
# 问答缓存：相同问题 + 相同索引/模型时跳过 LLM；默认开启，TTL 7 天
# CHAT_CACHE_ENABLED=1
# CHAT_CACHE_TTL_SEC=604800
# 双语检索/答案（需 Ollama 翻译模型，如 Hy-MT GGUF）
# BILINGUAL_RETRIEVAL=1
# BILINGUAL_ANSWER=1
# TRANSLATION_OLLAMA_MODEL=hy-mt1.5
# TRANSLATION_OLLAMA_URL=http://127.0.0.1:11434
# TRANSLATION_TEMPERATURE=0.1
# LOG_LEVEL=INFO
# PIPELINE_LOG=1
# LOG_STAGES=retrieve,rag,llm
