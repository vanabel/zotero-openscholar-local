# 复制为 apps/api/.env 后按需修改。未写出的变量在代码中有默认值（见 app/config.py）。
# 文档：仓库 docs/CONFIGURATION.md、docs/API.md、docs/OPERATIONS.md

# ── 路径（本机 Zotero 不在默认位置时取消注释）────────────────────────
# 默认 ~/Zotero/storage；建议绝对路径（启动 cwd 变化时仍稳定）
# ZOTERO_STORAGE_PATH=~/Zotero/storage
# 题录/作者/标签/集合只读同步；默认 ~/Zotero/zotero.sqlite，空字符串可关闭
# ZOTERO_SQLITE_PATH=~/Zotero/zotero.sqlite
# 应用数据：app.sqlite、parsed/、lance/、query_synonyms.json；默认 ./data
# DATA_DIR=./data
# 启动时 SQLite VACUUM（大量 DELETE 后回收空洞；需 API 独占库文件）
# DB_VACUUM_ON_STARTUP=0
# freelist 页占比 ≥ 该值时自动 VACUUM（默认 0.25）；0 = 仅 DB_VACUUM_ON_STARTUP=1 时执行
# DB_VACUUM_FREELIST_RATIO=0.25

# ── 对话 / 嵌入 Provider（可混用）────────────────────────────────────
# CHAT_PROVIDER / EMBED_PROVIDER：auto | ollama | openai | transformers（仅 CHAT）
#   auto = 配置了 OPENAI_API_KEY+BASE 时用 openai，否则 ollama
#   transformers = Hugging Face 直连 OpenScholar-8B（需 pip install -e '.[openscholar]'）
#   显式 ollama / openai 可「对话本地 + 嵌入在线」或反过来
# 摘要任务（summarize / paper_summary）使用 CHAT provider（Ollama 或 OpenAI），与嵌入无关
CHAT_PROVIDER=auto
EMBED_PROVIDER=auto

OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Ollama 地址；默认 http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# 主对话 OpenScholar-8B（二选一）：
# A) Ollama GGUF：CHAT_PROVIDER=ollama + OLLAMA_CHAT_MODEL=...
# OLLAMA_CHAT_MODEL=hf.co/QuantFactory/Llama-3.1_OpenScholar-8B-GGUF:Q4_K_M
# B) Transformers 直连（Ollama 不够用时）：CHAT_PROVIDER=transformers
# CHAT_PROVIDER=transformers
# OPENSCHOLAR_CHAT_MODEL=OpenSciLM/Llama-3.1_OpenScholar-8B
# OPENSCHOLAR_CHAT_DEVICE=auto
# OPENSCHOLAR_CHAT_MAX_NEW_TOKENS=4096

# OpenAI 兼容 API（CHAT 或 EMBED 为 openai/auto 时需要）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── 推荐组合（切换嵌入后请对文献库「重建索引」）────────────────────
#
# | 场景              | CHAT_PROVIDER | EMBED_PROVIDER | 还需 |
# |-------------------|---------------|----------------|------|
# | 全本地（默认）    | auto/ollama   | auto/ollama    | Ollama |
# | 全在线 API        | auto/openai   | auto/openai    | OPENAI_* |
# | 本地对话+在线嵌入 | ollama        | openai         | OPENAI_* + 重建索引 |
# | 在线对话+本地嵌入 | openai        | ollama         | OPENAI_* |
# | 本地对话+OS 检索  | ollama        | ollama         | OPENSCHOLAR_*=1 |
# | OS-8B Transformers | transformers | ollama/openai  | pip install -e '.[openscholar]' |
#
# - embedding_json 与 scholar_embedding_json 是两套向量；换 EMBED 模型须重建索引
# - OpenScholar Retriever/Reranker 仅本机 PyTorch，与 CHAT/EMBED 独立

# ── 检索（召回量、跨篇配额、稠密向量）────────────────────────────────
RETRIEVE_TOP_K_FTS=40
RETRIEVE_TOP_K_FINAL=8
# OpenScholar 稠密召回 + 精排（PyTorch；低配可设 0）
OPENSCHOLAR_RETRIEVER_ENABLED=1
OPENSCHOLAR_RERANKER_ENABLED=1
OPENSCHOLAR_DEVICE=auto
# 跨篇均衡：单篇最多 chunk / 最多文献（0 = 不限制该项）；默认 3 / 8
# RETRIEVE_MAX_CHUNKS_PER_PAPER=3
# RETRIEVE_MAX_PAPERS=8
# 综述/问答可先命中 summaries（paper_summary），再补 chunk 检索
# OPENSCHOLAR_RETRIEVER_MODEL=OpenSciLM/OpenScholar_Retriever
# OPENSCHOLAR_RERANKER_MODEL=OpenSciLM/OpenScholar_Reranker
# OPENSCHOLAR_RERANK_POOL=80
# OPENSCHOLAR_RETRIEVER_MAX_LENGTH=512
# OPENSCHOLAR_ENCODE_BATCH_SIZE=8
# OPENSCHOLAR_RERANK_BATCH_SIZE=8
# OPENSCHOLAR_RERANK_MAX_CHARS=1800
# HF_TOKEN=hf_xxx
# HF_ENDPOINT=https://hf-mirror.com
# LanceDB 稠密向量（pip install -e '.[lance]'）；0 则 SQLite 全表扫描
# LANCEDB_ENABLED=1

# ── PDF 解析（cli 本机 / cloud 在线 API）─────────────────────────────
MINERU_MODE=cli
# cloud：pnpm dev 不启本机 mineru-api；需 MINERU_API_TOKEN
# MINERU_API_TOKEN=
# MINERU_CLI=mineru
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_CLOUD_MODEL_VERSION=vlm
# MINERU_CLOUD_POLL_INTERVAL_SEC=5
# MINERU_CLOUD_MAX_PAGES_PER_CHUNK=200
# MINERU_CLI_STYLE=v3
# 常驻 mineru-api（pnpm dev 默认 8001，勿与 API 8000 冲突）
# MINERU_API_URL=http://127.0.0.1:8001
# MINERU_MODEL_SOURCE=local
# MINERU_TOOLS_CONFIG_JSON=/absolute/path/to/mineru.json
# MINERU_TASK_POLL_INTERVAL_SEC=8
# 低分解析自动云端重试（需 MINERU_API_TOKEN）
# PARSE_QUALITY_RETRY_ENABLED=1
# PARSE_QUALITY_RETRY_THRESHOLD=0.65
# MINERU_CLOUD_MODEL_VERSION_RETRY=pipeline

# ── 后台任务队列（index + summarize）────────────────────────────────
# TASK_WORKER_MODE：embedded（默认，API 进程内 Worker）| external（API 只入队）
# TASK_WORKER_CONCURRENCY：同时执行的任务数 1–16；index 与 summarize 共用队列
# TASK_WORKER_MODE=embedded
# TASK_WORKER_CONCURRENCY=1
# external：pnpm run dev:external 或另开 pnpm run dev:worker
# 文献库「任务队列概览」：GET /tasks/stats；POST /tasks/cancel-queued、cancel-orphans
# 批量入队：POST /papers/index-missing、parse-missing、summarize-missing
# 单篇：POST /papers/{id}/index、/summarize（默认 202 + task_id；?wait=true 同步）
# MINERU_PARSE_CONCURRENCY：同时跑 MinerU 解析的篇数（1–128；本机 GPU 建议 1–2，云端 API 可更高）
# MINERU_PARSE_CONCURRENCY=1
# INDEX_EMBED_CONCURRENCY=2

# ── 可选能力 ─────────────────────────────────────────────────────────
# 问答缓存（相同问题 + 相同索引/模型时跳过 LLM）；默认开启，TTL 7 天
# CHAT_CACHE_ENABLED=1
# CHAT_CACHE_TTL_SEC=604800
# 双语检索/答案（需 Ollama 翻译模型）
# BILINGUAL_RETRIEVAL=1
# BILINGUAL_ANSWER=1
# TRANSLATION_OLLAMA_MODEL=hy-mt1.5
# 专名同义词（默认 data/query_synonyms.json）
# RETRIEVE_QUERY_SYNONYMS_ENABLED=1
# RETRIEVE_QUERY_SYNONYMS_PATH=
# RETRIEVE_QUERY_SYNONYMS_MAX_VARIANTS=4
# TRANSLATION_OLLAMA_URL=http://127.0.0.1:11434
# TRANSLATION_TEMPERATURE=0.1
# LOG_LEVEL=INFO
# PIPELINE_LOG=1
# LOG_STAGES=retrieve,rag,llm,task,summary,index,parse,scan
