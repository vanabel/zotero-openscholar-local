DATA_DIR=./data
# 相对路径会在启动时解析为绝对路径（基于启动时的 cwd）。建议改为绝对路径，避免在不同目录启动 API 时连到另一份 app.sqlite
ZOTERO_STORAGE_PATH=~/Zotero/storage
# 只读同步题录/作者/标签/集合；设为空字符串可关闭。Zotero 打开时若锁库可能同步失败
# ZOTERO_SQLITE_PATH=~/Zotero/zotero.sqlite

OLLAMA_BASE_URL=http://127.0.0.1:11434
# 主对话模型：可为 qwen2.5:7b；若使用 OpenScholar-8B，请用 Ollama 可加载的 GGUF 创建后的名字（见 README「主对话模型使用 OpenScholar-8B」）
# OLLAMA_CHAT_MODEL=openscholar:8b
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# 可选：中英双语检索与答案（需 Ollama 已加载翻译模型，如从 ModelScope 导入的 Hy-MT GGUF）
# 问答缓存：相同问题 + 相同索引/模型配置时跳过 LLM（默认开启，TTL 默认 7 天）
# CHAT_CACHE_ENABLED=1
# CHAT_CACHE_TTL_SEC=604800

# BILINGUAL_RETRIEVAL=1
# BILINGUAL_ANSWER=1
# 检索：FTS 粗召回条数 / 向量重排后交给 LLM 的条数（final 不得超过 fts）
# RETRIEVE_TOP_K_FTS=40
# RETRIEVE_TOP_K_FINAL=8
# 跨篇均衡：避免单篇 PDF 垄断检索上下文（0 = 不限制该项）
# RETRIEVE_MAX_CHUNKS_PER_PAPER=3
# RETRIEVE_MAX_PAPERS=8
# OpenScholar 检索（需 pip install -e ".[openscholar]"；权重首次用时从 Hugging Face 自动下载，见 README）
# OPENSCHOLAR_RETRIEVER_ENABLED=1
# OPENSCHOLAR_RERANKER_ENABLED=1
# OPENSCHOLAR_RETRIEVER_MODEL=OpenSciLM/OpenScholar_Retriever
# OPENSCHOLAR_RERANKER_MODEL=OpenSciLM/OpenScholar_Reranker
# OPENSCHOLAR_DEVICE=auto
# OPENSCHOLAR_RERANK_POOL=80
# HF_TOKEN=hf_xxx   # 可选，减轻未登录限速
# HF_ENDPOINT=https://hf-mirror.com   # 可选，国内镜像（shell 或启动 API 前 export）
# TRANSLATION_OLLAMA_MODEL=hy-mt1.5
# TRANSLATION_OLLAMA_URL=http://127.0.0.1:11434
# TRANSLATION_TEMPERATURE=0.1

# 可选：OpenAI 兼容 Chat/Embeddings（优先于 Ollama）
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# MinerU：cli=本机 CLI + 可选 mineru-api；cloud=MinerU 在线 API（https://mineru.net）
MINERU_MODE=cli
# 在线 API（MINERU_MODE=cloud 时必填，Token 见 https://mineru.net/apiManage/docs）
# MINERU_API_BASE_URL=https://mineru.net
# MINERU_API_TOKEN=
# MINERU_CLOUD_MODEL_VERSION=vlm
# MINERU_CLOUD_POLL_INTERVAL_SEC=5
# 云端单文件页数上限（默认 200，与 mineru.net 限制一致）；超出则自动切片再合并
# MINERU_CLOUD_MAX_PAGES_PER_CHUNK=200
# MinerU 可执行文件：若 uvicorn 进程的 PATH 里没有 mineru，请写绝对路径，例如：
# MINERU_CLI=/Users/vanabel/.venv/bin/mineru
MINERU_CLI=mineru
# MinerU 3.x 使用 -p/-o（默认 v3）；仅旧版 CLI 才设 MINERU_CLI_STYLE=legacy
# MINERU_CLI_STYLE=v3
# 常驻 mineru-api：pnpm dev / npm run dev 会通过 scripts/dev-mineru-api.sh 在本机拉起 mineru-api，端口应与下一致（勿与 API 8000 冲突）
# MINERU_API_URL=http://127.0.0.1:8001
# 离线/本地化权重：见 README「MinerU 本地模型」；需 mineru.json 中 models-dir 指向已下载目录
# MINERU_MODEL_SOURCE=local
# MINERU_TOOLS_CONFIG_JSON=/absolute/path/to/mineru.json
# mineru CLI 轮询 mineru-api 任务间隔（秒）；hybrid 每步约 20s 时默认 8，可改为 10–15 进一步减日志
# MINERU_TASK_POLL_INTERVAL_SEC=8

# 日志：LOG_LEVEL 为根级别；PIPELINE_LOG 控制流水线阶段输出（0=关 1=简要 2=详细）
# LOG_STAGES 可选，逗号分隔：retrieve,embed,rag,llm,review,scan,index,parse,translate,cache（留空=全部）
# LOG_LEVEL=INFO
# PIPELINE_LOG=1
# LOG_STAGES=retrieve,rag,llm
