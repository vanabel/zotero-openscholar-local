# 复制为 scripts/hpc/sync_to_hpc.local.env（已 gitignore），供 sync_to_hpc.sh 读取。
# 文档：docs/HPC.md

# SSH 主机别名（~/.ssh/config 中的 Host，SWU 提交作业一般用 swu3）
HPC_SSH=swu3

# 超算上的家目录；留空则脚本 ssh 探测 $HOME（如 /public/home/<账号>）
# HPC_REMOTE_HOME=/public/home/td20190507

# 超算上的仓库路径
# REPO_REMOTE=~/zotero-openscholar-local

# Mac 本地模型根目录（与 apps/api/.env 中 OPENSCHOLAR_* 路径一致）
LOCAL_MODELS_ROOT="${HOME}/models"

# 超算模型目录（rsync 目标；.env.hpc 中 OPENSCHOLAR_RETRIEVER_MODEL 应指向此下子目录）
# REMOTE_MODELS_ROOT=${HPC_REMOTE_HOME}/models

# 是否同步精排权重（默认只同步 Retriever）
SYNC_RERANKER=0

# 是否同步整个 Hugging Face 缓存（体积大；出网差时用）
SYNC_HF_CACHE=0
# LOCAL_HF_CACHE="${HOME}/.cache/huggingface"
# REMOTE_HF_HOME=${HPC_REMOTE_HOME}/.cache/huggingface

# ── 超算 MinerU 解析（见 docs/HPC_PARSE.md）────────────────────────
# Mac Zotero 附件目录 → 超算（sync_to_hpc.sh pdfs）
# LOCAL_ZOTERO_STORAGE="${HOME}/Zotero/storage"
# REMOTE_ZOTERO_STORAGE=${HPC_REMOTE_HOME}/zotero-openscholar-local/apps/api/data/zotero-storage

# MinerU 本地权重（Mac: pnpm run download:mineru-models）
# LOCAL_MINERU_MODELS 默认 ${REPO_ROOT}/apps/api/data/mineru-models
